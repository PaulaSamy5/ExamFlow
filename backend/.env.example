PORT=5000

# SQL Server Configuration
DB_SERVER=localhost
DB_NAME=ExamsDB
DB_USER=exam_user
DB_PASSWORD=your_db_password_here

# JWT Secret — REQUIRED, must be a long random string, never use 'supersecret'
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars

# Frontend URL for CORS and password reset email links
FRONTEND_URL=http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com

# Admin Account Seed
# These are used ONCE on first startup to create the initial admin user.
# If an ADMIN role user already exists, these are ignored.
# Never commit real credentials — change the password immediately after first login.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe@FirstLogin!
ADMIN_NAME=System Administrator

# Email Configuration (SMTP)
# All outgoing emails are sent from SMTP_USER as "ExamFlow Platform"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=examflowplatform@gmail.com
# Gmail App Password (not your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASS=your_app_password_here
